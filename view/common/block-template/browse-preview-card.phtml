<?php
/**
 * Browse preview using resourceCard() helper with ART card config.
 * Edited from the BlockPlus extension for Omeka S.
 * https://github.com/Daniel-KM/Omeka-s-module-BlockPlus
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SitePageBlockRepresentation $block
 * @var \Omeka\Api\Representation\AbstractResourceEntityRepresentation[] $resources
 * @var string $resourceType
 * @var string $heading
 * @var string $limit
 * @var string $linkText
 * @var array $components
 * @var array $query
 */

$escape = $this->plugin('escapeHtml');

$showThumbnail = in_array('thumbnail', $components);

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $filterLocale ? $this->lang() : null;
$langValue = $filterLocale ? [$lang, ''] : null;

$cardOptions = [
    'show_thumbnail' => $showThumbnail,
    'lang' => $langValue,
];
?>
<div class="preview-block">

<?php if ($heading): ?>
<h2><?= $escape($heading) ?></h2>
<?php endif; ?>

<ul class="resource-list preview">
<?php foreach ($resources as $resource): ?>
    <?php
    // Safe extraction of dcterms:source
    $sourceVal = $resource->value('dcterms:source');
    $targetUrl = null;

    if ($sourceVal) {
        if ($sourceVal->type() === 'uri') {
            $targetUrl = $sourceVal->uri();
        } else {
            $targetUrl = $sourceVal->value();
        }
    }

    // Fallback to item URL if empty
    if (!$targetUrl) {
        $targetUrl = $resource->url();
    }

    $thumbnail = $showThumbnail ? $this->thumbnail($resource, 'medium') : '';
    ?>

    <li class="resource item">
        <?php if ($showThumbnail && $thumbnail): ?>
            <a href="<?= $this->escapeHtmlAttr($targetUrl) ?>" class="resource-thumbnail">
                <?= $thumbnail ?>
            </a>
        <?php endif; ?>

        <span class="resource-name">
            <a href="<?= $this->escapeHtmlAttr($targetUrl) ?>">
                <?= $escape($resource->displayTitle()) ?>
            </a>
        </span>
    </li>
<?php endforeach; ?>
</ul>

<?php
if ($linkText):
    echo $this->hyperlink($linkText, $this->url(
        'site/resource',
        ['controller' => $resourceType, 'action' => 'browse'],
        ['query' => $query],
        true
    ));
endif;
?>

</div>
